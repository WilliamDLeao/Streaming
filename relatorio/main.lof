\contentsline {figure}{\numberline {1}{\ignorespaces Representação esquemática física do sistema de processamento de eventos em \textit {streaming}: chegada $\lambda (t)$, ingestão, fila $q(t)$, drenagem pelos operadores à capacidade efetiva $\mu (t)$ e malha de controle/alocação de recursos}}{7}{figure.caption.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Diagrama de blocos do sistema de controle de fila em \textit {streaming} (variáveis incrementais em torno de $\lambda _0=\mu _0=1000\text { eventos/s}$, $q(0)=600\text { eventos}$)}}{8}{figure.caption.3}%
\contentsline {figure}{\numberline {3}{\ignorespaces Resposta em malha aberta da redução da fila $x(t)$, da fila real $q(t)$ e da capacidade efetiva $\mu (t)$ para degraus incrementais $U_0 = 100$ e $300\text { eventos/s}$, evidenciando a rampa assintótica até o esvaziamento físico $q(t)=0$}}{10}{figure.caption.4}%
\contentsline {figure}{\numberline {4}{\ignorespaces Análise do controlador proporcional para $K \in \{0{,}08,\, 0{,}125,\, 0{,}369,\, 2{,}0\}$: (a) Lugar Geométrico das Raízes e (b) efeito dos polos sobre a velocidade e as oscilações da fila}}{14}{figure.caption.6}%
\contentsline {figure}{\numberline {5}{\ignorespaces Lugar Geométrico das Raízes dos sistemas compensados (P, PI, PD e PID) e localização dos polos de malha fechada no ponto de projeto ($k=1$)}}{17}{figure.caption.8}%
\contentsline {figure}{\numberline {6}{\ignorespaces Diagramas de Bode das funções de transferência de malha aberta compensada $L(j\omega )$ para P, PI, PD e PID com indicação das margens de ganho ($\mathrm {GM}$) e de fase ($\mathrm {PM}$)}}{18}{figure.caption.9}%
\contentsline {figure}{\numberline {7}{\ignorespaces Evidências computacionais das limitações dinâmicas e não lineares: (acima) efeito da saturação, \textit {windup}, \textit {anti-windup} (\textit {clamping} e \textit {back-calculation}) e \textit {derivative kick} em escala logarítmica para o PID; (abaixo) divergência linear e ciclo limite sob saturação no PI instável ($K_p=0{,}50,\,K_i=0{,}30$)}}{20}{figure.caption.10}%
\contentsline {figure}{\numberline {8}{\ignorespaces Comparação temporal ($0$ a $60\text { s}$) da redução da fila $x(t)$ e da fila real $q(t)$ para P, PI, PD e PID (à esquerda, regime linear; à direita, com saturação $[600,\,1400]\text { eventos/s}$ e $q(t) \ge 0$), sob degrau $x_r = 300$ em $t=0$ e perturbação $\Delta \lambda = +100\text { eventos/s}$ em $t=20\text { s}$}}{21}{figure.caption.11}%
\contentsline {figure}{\numberline {9}{\ignorespaces Capacidade solicitada $\mu _c(t)$ (painéis superiores) e capacidade efetiva $\mu (t)$ (painéis inferiores) ao longo de $60\text { s}$ e detalhe dos primeiros $6\text { s}$, comparando as solicitações aos limites físicos $[600,\,1400]\text { eventos/s}$}}{22}{figure.caption.12}%
